{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "ink", "color": "#16202c", "name": "Ink" },
				{ "slug": "primary", "color": "#14223a", "name": "Primary Navy" },
				{ "slug": "accent", "color": "#9a7b4f", "name": "Accent Brass" },
				{ "slug": "surface", "color": "#f5f2ec", "name": "Surface" },
				{ "slug": "muted", "color": "#5f6b78", "name": "Muted" },
				{ "slug": "white", "color": "#ffffff", "name": "White" }
			]
		},
		"typography": {
			"customFontSize": true,
			"fontFamilies": [
				{ "fontFamily": "\"Canela\", \"Tiempos Headline\", Georgia, serif", "slug": "display", "name": "Display Serif" },
				{ "fontFamily": "\"Inter\", \"Helvetica Neue\", Arial, sans-serif", "slug": "body", "name": "Body Sans" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "normal", "size": "1.0625rem", "name": "Normal" },
				{ "slug": "lead", "size": "1.375rem", "name": "Lead" },
				{ "slug": "large", "size": "1.9rem", "name": "Large" },
				{ "slug": "xlarge", "size": "2.9rem", "name": "X-Large" }
			]
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"]
		}
	},
	"styles": {
		"color": { "background": "#ffffff", "text": "#16202c" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.6" },
		"elements": {
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } },
			"h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } },
			"link": { "color": { "text": "#14223a" } }
		}
	}
}
